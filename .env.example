# ========== Frontend ==========
VITE_BACKEND_URL="https://localhost/backend/api/v1"



# ========== Backend ==========
# VITE_BACKEND_URL

USER_JWT_ACCESS_TOKEN_SECRET="jwt_access_secret"
USER_JWT_ACCESS_TOKEN_EXPIRATION_HOURS=1
USER_JWT_REFRESH_TOKEN_SECRET="jwt_refresh_secret"
USER_JWT_REFRESH_TOKEN_EXPIRATION_HOURS=240

COOKIE_HTTPONLY=true
COOKIE_SECURE=true
COOKIE_SAMESITE="lax"

REDIS_HOST="sm-redis" # tls stud-match.mooo.com raw sm-redis
REDIS_PORT=6350 # tls 6150 raw 6350
R_PASSWORD="password_superPuper"

POSTGRES_HOST="sm-postgres" # tls stud-match.mooo.com raw sm-postgres
POSTGRES_PORT=5432 # tls 5200 raw 5432
POSTGRES_SSLMODE="allow"
PG_DB="sm-db"
PG_USER="sm-admin"
PG_PASSWORD="password_superPuper"

RUSTFS_URL="http://sm-rustfs:9250" # tls https://stud-match.mooo.com:9050 raw http://sm-rustfs:9250
RUSTFS_BUCKET="sm-bucket"
RFS_ACCESS_KEY="rfsadmin50"
RFS_SECRET_KEY="rfsadmin150"
RUSTFS_REGION="ru-central1"

KF_HOST="sm-kafka" # tls stud-match.mooo.com raw sm-kafka
KF_PORT=8292 # tls 8092 raw 8292
KF_USERNAME="backend_1"
KF_PASSWORD="Bk1password"

KF_FTRS_TASKS_TOPIC="features.tasks"
KF_FTRS_RESULTS_TOPIC="features.results"
KF_FTRS_CONSUMER_GROUP="sm-backend-features"

KF_DIST_TASKS_TOPIC="distribution.tasks"
KF_DIST_RESULTS_TOPIC="distribution.results"
KF_DIST_CONSUMER_GROUP="sm-backend-distribution"



