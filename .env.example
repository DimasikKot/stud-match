KF_PASSWORD="Bk9fT2wQpLxZm4Rv"


# ========== Frontend ==========
VITE_BACKEND_URL="https://localhost/backend/api/v1"


# ========== LLM Worker ==========
HF_TOKEN="hf_xxxxx"
# Креды пользователя llm_worker_N из kafka/auth.conf. Для 2-го/3-го воркера
# в его .env подставьте llm_worker_2/llm_worker_3 и соответствующий пароль.
LLM_KF_USERNAME="llm_worker_1"
LLM_KF_PASSWORD="Wkr1a8Kd2nPq5Xs"


# ========== Postgres ==========
POSTGRES_DB="sm-db" # опционально, по умолчанию postgres
POSTGRES_USER="sm-admin" # опционально, по умолчанию postgres
POSTGRES_PASSWORD="password_superPuper"
ADMIN_EMAIL="admin@stud-match.ru" # админ, создаётся при первой инициализации БД
ADMIN_PASSWORD="admin" # обязательно смените


# ========== Redis ==========
REDIS_PASSWORD="password_superPuper"


# ========== RustFS ==========
RUSTFS_ADDRESS="0.0.0.0:9250" # ssl 9050 raw 9250
RUSTFS_CONSOLE_ADDRESS="0.0.0.0:9350"  # ssl 9150 raw 9350
RUSTFS_ACCESS_KEY="rfsadmin50"
RUSTFS_SECRET_KEY="rfsadmin150"


# ========== Kafka ==========
# Адрес брокера для клиентов (backend в docker-сети: sm-kafka:19094;
# снаружи: публичный хост + KAFKA_SSL_PORT). Креды — KF_* у backend
# и LLM_KF_* у воркера, они задаются в своих секциях выше.
KAFKA_HOST="sm-kafka"
KAFKA_PORT=19094
# Хост в advertised.listeners для внешних SSL-клиентов (localhost | stud-match.mooo.com)
KAFKA_ADVERTISED_HOST="localhost"
KAFKA_SSL_PORT=9193               # внешний SASL_SSL-порт на хосте (внутри контейнера 9093)