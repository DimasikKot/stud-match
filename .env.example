USER_JWT_REFRESH_TOKEN_EXPIRATION_HOURS=240

COOKIE_HTTPONLY=true
COOKIE_SECURE=true
COOKIE_SAMESITE="lax"

RUSTFS_URL="http://sm-rustfs:9250"
RUSTFS_BUCKET="sm-bucket"
