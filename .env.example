KAFKA_HOST="sm-kafka"             # sm-kafka локально / stud-match.mooo.com на сервере
KAFKA_PORT=9092                   # PLAINTEXT внутри docker-сети / 9193 SSL снаружи (TLS по порту 9093/9193)
KAFKA_CLUSTER_ID="SmKafkaCluster1Ab2CdEf"
SM_KAFKA_STORE_PASSWORD="changeit" # пароль keystore/truststore (генерируются при старте)