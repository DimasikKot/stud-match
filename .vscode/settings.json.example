{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.jj": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "postgres/ssl": true,
    "frontend/main.tsx": true,
    "frontend/index.html": true,
    "frontend/node_modules": true,
    "frontend/eslint.config.js": true,
    "frontend/tsconfig.json": true,
    "frontend/tsconfig.node.json": true,
    "frontend/vite.config.ts": true,
    ".github/": true,
    "nginx/": true,
    "redis/": true,
    ".pre-commit-config.yaml": true,
    "rpi5.docker-compose.yaml": true,
    ".gitattributes": true,
    ".dockerignore": true,
    "backend/requirements.dev.txt": true,
    "**/.pytest_cache": true,
    "**/__pycache__": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "prettier.tabWidth": 2,
    "editor.formatOnSave": true,
    "editor.insertSpaces": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "prettier.tabWidth": 2,
    "editor.formatOnSave": true,
    "editor.insertSpaces": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "prettier.tabWidth": 2,
    "editor.formatOnSave": true,
    "editor.insertSpaces": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "prettier.tabWidth": 2,
    "editor.formatOnSave": true,
    "editor.insertSpaces": true
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.tabSize": 4,
    "prettier.tabWidth": 4,
    "editor.formatOnSave": true,
    "editor.insertSpaces": true
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "prettier.tabWidth": 2,
    "editor.formatOnSave": true,
    "editor.insertSpaces": true
  },
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "[dockercompose]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[html]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[cpp]": {
    "editor.wordBasedSuggestions": "off",
    "editor.semanticHighlighting.enabled": true,
    "editor.stickyScroll.defaultModel": "foldingProviderModel",
    "editor.formatOnSave": true,
    "editor.suggest.insertMode": "replace"
  },
  "[bat]": {
    "editor.formatOnSave": true,
    "files.eol": "\r\n"
  },
  "[sql]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "inferrinizzard.prettier-sql-vscode"
  },
  "editor.unicodeHighlight.allowedLocales": {
    "ru": true
  },
  "python.analysis.extraPaths": ["./backend"],
  "python.autoComplete.extraPaths": ["./backend"],
  "files.eol": "\n",
  "editor.detectIndentation": true,
  "editor.mouseWheelZoom": true,
  "explorerExclude.backup": {},
  "indentRainbow.colors": [
    "rgba(255,255,64,0.02)",
    "rgba(127,255,127,0.02)",
    "rgba(255,127,255,0.02)",
    "rgba(79,236,236,0.02)"
  ],
  "python.analysis.typeCheckingMode": "standard",
  "python-envs.defaultEnvManager": "ms-python.python:system",
  "explorerExcludeManager.backup": {},
  "commentTranslate.targetLanguage": "ru",
  "python.terminal.useEnvFile": true
}
