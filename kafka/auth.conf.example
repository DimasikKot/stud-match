# ============================================================================
#  Kafka auth.conf - пользователи, топики и права доступа (ACL)
# ============================================================================
#
# Этот файл читается kafka/entrypoint.sh при КАЖДОМ старте контейнера sm-kafka:
#   - user   → генерирует JAAS-конфиг с SASL/PLAIN пользователями;
#   - topic  → создаёт топики (если нет - создаёт, если есть - пропускает);
#   - acl    → выдаёт права на топики, consumer groups и cluster.
#
# После изменений применить:
#   docker compose restart sm-kafka
# (или docker compose up -d --force-recreate sm-kafka)
#
# Механизм аутентификации - SASL/PLAIN поверх SASL_SSL (трафик шифруется TLS,
# пароль внутри TLS не виден).
#
# Имена переменных в .env клиентов:
#   backend     → KF_USERNAME / KF_PASSWORD
#   llm-worker  → LLM_KF_USERNAME / LLM_KF_PASSWORD
# Пароль каждого user ниже должен совпадать с паролем в .env клиента.
#
# ----------------------------------------------------------------------------
# ФОРМАТ
# ----------------------------------------------------------------------------
# Одна директива на строку. Строки, начинающиеся с #, и пустые строки
# игнорируются. Имена и пароли НЕ должны содержать пробелов.
#
#   user <name> <password>
#       SASL/PLAIN пользователь. <name> - латиница, цифры, подчёркивание
#       (дефисы допустимы, но подчёркивание надёжнее).
#
#   topic <name> <partitions>
#       Топик с заданным числом partitions (replication-factor всегда 1).
#       partitions в llm.tasks = сколько воркеров может брать задачи
#       параллельно (поэтому 3 - под 3 воркера).
#
#   acl <principal> <тип> <имя|-> <операции>
#       Права доступа.
#         principal   - User:<name>, имя должно совпадать с user выше
#         тип         - topic | group | cluster
#         имя         - имя топика / consumer group; для cluster ставь '-'
#         операции    - через запятую БЕЗ пробелов:
#
#           Read              читать топик / входить в consumer group
#           Write             писать в топик
#           Describe          метаданные топика / группы (нужна почти всем
#                            клиентам - без неё клиент не видит топик)
#           Create            создавать топики
#           Delete            удалять топики
#           Alter             изменять конфигурацию топика
#           DescribeConfigs   читать конфигурацию
#           AlterConfigs      менять конфигурацию
#           IdempotentWrite   идемпотентный продьюсер
#           ClusterAction     действия уровня кластера
#
# ----------------------------------------------------------------------------



user backend_1              Bk1password
user backend_2              Bk2password
user backend_3              Bk3password

user worker_tags_1          Tg1password
user worker_tags_2          Tg2password
user worker_tags_3          Tg3password

user worker_distribution_1  Db1password
user worker_distribution_2  Db2password
user worker_distribution_3  Db3password



topic tags.tasks            3
topic tags.results          1

topic distribution.tasks    3
topic distribution.results  1



# --- backend_1 / _2 / _3 (одинаковые права, общие группы sm-backend-*) ---
acl User:backend_1 topic tags.tasks Write,Describe
acl User:backend_1 topic tags.results Read,Describe
acl User:backend_1 group sm-backend-tags Read,Describe
acl User:backend_1 topic distribution.tasks Write,Describe
acl User:backend_1 topic distribution.results Read,Describe
acl User:backend_1 group sm-backend-distribution Read,Describe
acl User:backend_1 cluster - Describe

acl User:backend_2 topic tags.tasks Write,Describe
acl User:backend_2 topic tags.results Read,Describe
acl User:backend_2 group sm-backend-tags Read,Describe
acl User:backend_2 topic distribution.tasks Write,Describe
acl User:backend_2 topic distribution.results Read,Describe
acl User:backend_2 group sm-backend-distribution Read,Describe
acl User:backend_2 cluster - Describe

acl User:backend_3 topic tags.tasks Write,Describe
acl User:backend_3 topic tags.results Read,Describe
acl User:backend_3 group sm-backend-tags Read,Describe
acl User:backend_3 topic distribution.tasks Write,Describe
acl User:backend_3 topic distribution.results Read,Describe
acl User:backend_3 group sm-backend-distribution Read,Describe
acl User:backend_3 cluster - Describe



# --- worker_tags_1 / _2 / _3 (одинаковые права, общая группа sm-workers-tags) ---
acl User:worker_tags_1 topic tags.tasks Read,Describe
acl User:worker_tags_1 topic tags.results Write,Describe
acl User:worker_tags_1 group sm-workers-tags Read,Describe
acl User:worker_tags_1 cluster - Describe

acl User:worker_tags_2 topic tags.tasks Read,Describe
acl User:worker_tags_2 topic tags.results Write,Describe
acl User:worker_tags_2 group sm-workers-tags Read,Describe
acl User:worker_tags_2 cluster - Describe

acl User:worker_tags_3 topic tags.tasks Read,Describe
acl User:worker_tags_3 topic tags.results Write,Describe
acl User:worker_tags_3 group sm-workers-tags Read,Describe
acl User:worker_tags_3 cluster - Describe



# --- worker_distribution_1 / _2 / _3 (одинаковые права, общая группа sm-workers-distribution) ---
acl User:worker_distribution_1 topic distribution.tasks Read,Describe
acl User:worker_distribution_1 topic distribution.results Write,Describe
acl User:worker_distribution_1 group sm-workers-distribution Read,Describe
acl User:worker_distribution_1 cluster - Describe

acl User:worker_distribution_2 topic distribution.tasks Read,Describe
acl User:worker_distribution_2 topic distribution.results Write,Describe
acl User:worker_distribution_2 group sm-workers-distribution Read,Describe
acl User:worker_distribution_2 cluster - Describe

acl User:worker_distribution_3 topic distribution.tasks Read,Describe
acl User:worker_distribution_3 topic distribution.results Write,Describe
acl User:worker_distribution_3 group sm-workers-distribution Read,Describe
acl User:worker_distribution_3 cluster - Describe
