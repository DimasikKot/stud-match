// --- ENUMS ---

Enum user_role {
  admin              // администратор
  teacher            // преподаватель
}

Enum zip_status {
  pending            // ожидает обработки
  processing         // обрабатывается
  completed          // обработан
  failed             // ошибка обработки
}

Enum file_status {
  not_extracted      // не извлечены признаки
  queued             // в очереди на извлечение
  extracting         // извлекаются признаки
  extracted          // извлечены признаки
  failed             // ошибка извлечения
  applied            // учтён при формировании профиля студента (для пропуске при создании профиля)
}

Enum distribution_status {
  not_started        // не запускался
  queued             // в очереди на распределение
  distributing       // распределяются
  distributed        // распределен
  failed             // ошибка распределения
}

// --- TABLES ---

Table users {
  id SERIAL [pk, increment]
  fullname VARCHAR(255) [not null]
  email VARCHAR(255) [unique, not null]
  hashed_password VARCHAR(255) [not null]
  role user_role [not null, default: 'teacher']
  skills_set JSONB [not null, default: '{}'] // Набор навыков, меняет админ
  model_version VARCHAR(255) [not null, default: '-'] // Версия модели, которая создала набор навыков

  // сортировка, отображать когда были последние изменения
  updated_at TIMESTAMP [not null, default: `CURRENT_TIMESTAMP`]
}

Table zips {
  id SERIAL [pk, increment]
  status zip_status [not null, default: 'pending']

  // Название работы, например "Курсовая работа по математике" для обьединения работ
  name VARCHAR(255) [not null]

  // Когда выполнена работа, указывает препод, для коэффициента занчимости
  date TIMESTAMP [not null, default: `CURRENT_TIMESTAMP`]
}

Table files {
  id SERIAL [pk, increment]
  name VARCHAR(255) [not null]
  size INT [not null]
  rustfs_object_key VARCHAR(255) [not null]
  rustfs_bucket VARCHAR(255) [not null]
  status file_status [not null, default: 'not_extracted']
  feature_set JSONB [not null, default: '{}'] // Набор признаков
  model_version VARCHAR(255) [not null, default: '-'] // Версия модели, которая создала признаки

  zip_id INT [not null]

  Indexes {
    zip_id [name: "files_zip_id_idx"]
    status [name: "files_status_idx"]
  }
}

Table skills {
  id SERIAL [pk, increment]
  name VARCHAR(255) [not null] // Для вывода преподаватедю варинатов признаков
}

Table students {
  id SERIAL [pk, increment]
  fullname VARCHAR(255) [not null]
  skills_set JSONB [not null, default: '{}']
  model_version VARCHAR(255) [not null, default: '-'] // Версия модели, которая создала набор навыков
}

Table student_files {
  file_id INT [not null]
  student_id INT [not null]

  Indexes {
    (file_id, student_id) [pk]
    student_id [name: "student_files_student_id_idx"]
  }
}

Table projects {
  id SERIAL [pk, increment]
  user_id INT [not null] // Преподаватель, создавший проект
  name VARCHAR(255) [not null]
  description TEXT [not null]
  constraints_set JSONB [not null, default: '{}'] // Набор ограничений
  skills_set JSONB [not null, default: '{}'] // Набор навыков, меняет преподаватель
  model_version VARCHAR(255) [not null, default: '-'] // Версия модели, которая создала набор навыков
  updated_at TIMESTAMP [not null, default: `CURRENT_TIMESTAMP`] // сортировка

  Indexes {
    user_id [name: "projects_user_id_idx"]
  }
}

Table distributions {
  id SERIAL [pk, increment]
  user_id INT [not null] // Преподаватель, запустивший распределение
  name VARCHAR(255) [not null]
  status distribution_status [not null, default: 'not_started']
  
  // Списки сущностей, выбранных для распределения
  selected_project_ids JSONB [not null, default: '[]']
  selected_student_ids JSONB [not null, default: '[]']
  selected_teacher_ids JSONB [not null, default: '[]']
  
  // Результат: массив преподавателей -> проекты -> студенты
  // JSONB который хранит массив словарей преподавателей, 
  // каждый препод хранит массив словарей проектов,
  // каждый проект хранит массив ФИО подобранных студентов и вектора их признаков
  result_set JSONB [not null, default: '{}'] // Результат распределения
  model_version VARCHAR(255) [not null, default: '-'] // Версия модели, которая создала результат
  updated_at TIMESTAMP [not null, default: `CURRENT_TIMESTAMP`] // сортировка

  Indexes {
    user_id [name: "distributions_user_id_idx"]
  }
}

// --- RELATIONSHIPS ---

Ref: users.id < projects.user_id [delete: cascade]
Ref: users.id < distributions.user_id [delete: cascade]

Ref: zips.id < files.zip_id [delete: cascade]

Ref: files.id < student_files.file_id [delete: cascade]
Ref: students.id < student_files.student_id [delete: cascade]